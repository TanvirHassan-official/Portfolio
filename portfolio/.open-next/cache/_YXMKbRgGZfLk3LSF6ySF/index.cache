no);background:#99F7AB;color:#111f26\">View Projects →</a><a href=\"/assets/resume.pdf\" download=\"Tanvir-Hassan-Resume.pdf\" class=\"inline-flex items-center gap-2 px-7 py-[13px] rounded-md text-[0.78rem] tracking-[0.04em] uppercase transition-all duration-200 hover:-translate-y-[2px]\" style=\"font-family:var(--font-mono);background:transparent;border:1px solid #99F7AB;color:#99F7AB\">⬇ Download CV</a><a href=\"#contact\" class=\"inline-flex items-center gap-2 px-7 py-[13px] rounded-md text-[0.78rem] tracking-[0.04em] uppercase transition-all duration-200 hover:-translate-y-[2px]\" style=\"font-family:var(--font-mono);background:var(--glass);border:1px solid var(--glass-border);backdrop-filter:blur(12px);color:#D6F9DD\">Contact Me</a></div><div class=\"reveal reveal-delay-4 grid grid-cols-2 sm:grid-cols-4 gap-[1px] rounded-md overflow-hidden\"><div class=\"py-[18px] px-4 text-center\" style=\"background:var(--glass);border:1px solid var(--glass-border);backdrop-filter:blur(12px)\"><div class=\"leading-none mb-1 font-bold\" style=\"font-family:var(--font-display);font-size:1.8rem;color:#99F7AB\">2+</div><div class=\"text-[0.62rem] uppercase tracking-[0.08em]\" style=\"font-family:var(--font-mono);color:rgba(214,249,221,0.32)\">Years Exp.</div></div><div class=\"py-[18px] px-4 text-center\" style=\"background:var(--glass);border:1px solid var(--glass-border);backdrop-filter:blur(12px)\"><div class=\"leading-none mb-1 font-bold\" style=\"font-family:var(--font-display);font-size:1.8rem;color:#99F7AB\">15+</div><div class=\"text-[0.62rem] uppercase tracking-[0.08em]\" style=\"font-family:var(--font-mono);color:rgba(214,249,221,0.32)\">Projects</div></div><div class=\"py-[18px] px-4 text-center\" style=\"background:var(--glass);border:1px solid var(--glass-border);backdrop-filter:blur(12px)\"><div class=\"leading-none mb-1 font-bold\" style=\"font-family:var(--font-display);font-size:1.8rem;color:#99F7AB\">98</div><div class=\"text-[0.62rem] uppercase tracking-[0.08em]\" style=\"font-family:var(--font-mono);color:rgba(214,249,221,0.32)\">Lighthouse</div></div><div class=\"py-[18px] px-4 text-center\" style=\"background:var(--glass);border:1px solid var(--glass-border);backdrop-filter:blur(12px)\"><div class=\"leading-none mb-1 font-bold\" style=\"font-family:var(--font-display);font-size:1.8rem;color:#99F7AB\">100%</div><div class=\"text-[0.62rem] uppercase tracking-[0.08em]\" style=\"font-family:var(--font-mono);color:rgba(214,249,221,0.32)\">Satisfaction</div></div></div></div><div class=\"max-w-100 w-full mx-auto lg:mx-0\"><div class=\"relative w-full rounded-sm overflow-hidden\" style=\"aspect-ratio:4/5;background:#1e3c47;border:1px solid var(--glass-border)\"><img alt=\"Tanvir Hassan — Frontend Developer\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover object-top\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"w-full\" srcSet=\"/_next/image?url=%2Fassets%2Fhehe.jpeg&amp;w=32&amp;q=75 32w, /_next/image?url=%2Fassets%2Fhehe.jpeg&amp;w=48&amp;q=75 48w, /_next/image?url=%2Fassets%2Fhehe.jpeg&amp;w=64&amp;q=75 64w, /_next/image?url=%2Fassets%2Fhehe.jpeg&amp;w=96&amp;q=75 96w, /_next/image?url=%2Fassets%2Fhehe.jpeg&amp;w=128&amp;q=75 128w, /_next/image?url=%2Fassets%2Fhehe.jpeg&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fassets%2Fhehe.jpeg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fassets%2Fhehe.jpeg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fassets%2Fhehe.jpeg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fassets%2Fhehe.jpeg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fassets%2Fhehe.jpeg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fassets%2Fhehe.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fassets%2Fhehe.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fassets%2Fhehe.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fassets%2Fhehe.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fassets%2Fhehe.jpeg&amp;w=3840&amp;q=75\"/><div class=\"absolute inset-0\" style=\"background:linear-gradient(to bottom, transparent 55%, rgba(17,31,38,0.75))\"></div><div class=\"absolute bottom-5 left-1/2 -translate-x-1/2 z-10 flex items-center gap-2 px-[18px] py-2 rounded-[4px] text-[0.68rem] tracking-[0.06em] uppercase whitespace-nowrap\" style=\"font-family:var(--font-mono);color:#99F7AB;background:rgba(25,50,60,0.85);border:1px solid var(--glass-border);backdrop-filter:blur(12px)\"><span class=\"w-[6px] h-[6px] rounded-full bg-[#99F7AB] animate-blink\"></span>Open to work</div></div></div></div></div></section><section id=\"about\" class=\"py-[clamp(80px,11vw,130px)]\"><div class=\"max-w-[1120px] mx-auto px-5 md:px-[60px]\"><div class=\"grid md:grid-cols-2 gap-20 items-start\"><div><div class=\"reveal mb-4 inline-flex items-center gap-2 text-[0.68rem] uppercase tracking-[0.14em] font-[family-name:var(--font-mono)] text-[#99F7AB]\"><span class=\"text-[rgba(214,249,221,0.32)]\">—</span>About Me</div><h2 class=\"reveal reveal-delay-1 font-bold leading-[1.08] tracking-[-0.02em] mb-4 font-[family-name:var(--font-display)] text-[clamp(2.2rem,4.5vw,3.4rem)] text-[#D6F9DD]\">Developer,<br/>not just a coder.</h2><div class=\"reveal reveal-delay-2 space-y-5 text-[1rem] leading-[1.85] text-[rgba(214,249,221,0.62)]\"><p>I&#x27;m<!-- --> <strong class=\"font-bold text-[#D6F9DD]\">Tanvir Hassan</strong>, a frontend developer from Dhaka, Bangladesh with a deep passion for crafting web experiences that are technically strong and visually compelling. My journey began when I first discovered how a few lines of HTML could create something on screen — and I have been hooked ever since.</p><p>My specialty lies in the<!-- --> <strong class=\"font-bold text-[#D6F9DD]\">React and Next.js ecosystem</strong>. I enjoy building component-driven architectures that are clean, maintainable, and performant. I don&#x27;t just write code that works — I write code that scales, passes accessibility checks, and performs well on Core Web Vitals.</p><p>I&#x27;m currently<!-- --> <strong class=\"font-bold text-[#D6F9DD]\">expanding into full-stack development</strong> <!-- -->with the MERN stack, and I&#x27;m genuinely excited about building end-to-end products. I believe the best developers are naturally curious, and I&#x27;m always learning.</p><p>Outside the screen, you&#x27;ll usually find me exploring UI design trends, following technology news, or enjoying a quiet evening with a good book. I bring that same attention to detail into every project I build.</p></div></div><div class=\"reveal reveal-delay-3 flex flex-col gap-3\"><div class=\"flex items-center gap-4 px-6 py-5 rounded-md cursor-default transition-all duration-300 hover:translate-x-[5px] hover:border-[rgba(153,247,171,0.25)] border border-[rgba(153,247,171,0.14)] backdrop-blur-[16px] bg-[rgba(153,247,171,0.06)]\"><div class=\"w-10 h-10 shrink-0 rounded-sm flex items-center justify-center text-[1.1rem] bg-[rgba(153,247,171,0.18)] border border-[rgba(153,247,171,0.14)]\">⚡</div><div><div class=\"font-bold text-[0.88rem] mb-1 text-[#D6F9DD]\">Performance-first mindset</div><div class=\"text-[0.65rem] font-[family-name:var(--font-mono)] text-[rgba(214,249,221,0.32)]\">Core Web Vitals · Lighthouse · Bundle analysis</div></div></div><div class=\"flex items-center gap-4 px-6 py-5 rounded-md cursor-default transition-all duration-300 hover:translate-x-[5px] hover:border-[rgba(153,247,171,0.25)] border border-[rgba(153,247,171,0.14)] backdrop-blur-[16px] bg-[rgba(153,247,171,0.06)]\"><div class=\"w-10 h-10 shrink-0 rounded-sm flex items-center justify-center text-[1.1rem] bg-[rgba(153,247,171,0.18)] border border-[rgba(153,247,171,0.14)]\">♿</div><div><div class=\"font-bold text-[0.88rem] mb-1 text-[#D6F9DD]\">Accessibility by default</div><div class=\"text-[0.65rem] font-[family-name:var(--font-mono)] text-[rgba(214,249,221,0.32)]\">WCAG 2.1 · Semantic HTML · Keyboard nav</div></div></div><div class=\"flex items-center gap-4 px-6 py-5 rounded-md cursor-default transition-all duration-300 hover:translate-x-[5px] hover:border-[rgba(153,247,171,0.25)] border border-[rgba(153,247,171,0.14)] backdrop-blur-[16px] bg-[rgba(153,247,171,0.06)]\"><div class=\"w-10 h-10 shrink-0 rounded-sm flex items-center justify-center text-[1.1rem] bg-[rgba(153,247,171,0.18)] border border-[rgba(153,247,171,0.14)]\">📱</div><div><div class=\"font-bold text-[0.88rem] mb-1 text-[#D6F9DD]\">Truly responsive design</div><div class=\"text-[0.65rem] font-[family-name:var(--font-mono)] text-[rgba(214,249,221,0.32)]\">Mobile-first · All viewports · Touch-friendly</div></div></div><div class=\"flex items-center gap-4 px-6 py-5 rounded-md cursor-default transition-all duration-300 hover:translate-x-[5px] hover:border-[rgba(153,247,171,0.25)] border border-[rgba(153,247,171,0.14)] backdrop-blur-[16px] bg-[rgba(153,247,171,0.06)]\"><div class=\"w-10 h-10 shrink-0 rounded-sm flex items-center justify-center text-[1.1rem] bg-[rgba(153,247,171,0.18)] border border-[rgba(153,247,171,0.14)]\">🎨</div><div><div class=\"font-bold text-[0.88rem] mb-1 text-[#D6F9DD]\">Design sensibility</div><div class=\"text-[0.65rem] font-[family-name:var(--font-mono)] text-[rgba(214,249,221,0.32)]\">Figma · Design systems · Component tokens</div></div></div><div class=\"flex items-center gap-4 px-6 py-5 rounded-md cursor-default transition-all duration-300 hover:translate-x-[5px] hover:border-[rgba(153,247,171,0.25)] border border-[rgba(153,247,171,0.14)] backdrop-blur-[16px] bg-[rgba(153,247,171,0.06)]\"><div class=\"w-10 h-10 shrink-0 rounded-sm flex items-center justify-center text-[1.1rem] bg-[rgba(153,247,171,0.18)] border border-[rgba(153,247,171,0.14)]\">🚀</div><div><div class=\"font-bold text-[0.88rem] mb-1 text-[#D6F9DD]\">Growing into full-stack</div><div class=\"text-[0.65rem] font-[family-name:var(--font-mono)] text-[rgba(214,249,221,0.32)]\">MERN Stack · Node.js · Express · MongoDB</div></div></div></div></div></div></section><section id=\"education\" class=\"py-[clamp(80px,11vw,130px)]\"><div class=\"max-w-[1120px] mx-auto px-5 md:px-[60px]\"><div class=\"text-center mb-14\"><div class=\"reveal inline-flex items-center gap-[10px] mb-[18px] text-[0.68rem] tracking-[0.14em] uppercase\" style=\"font-family:var(--font-mono);color:#99F7AB\"><span style=\"color:rgba(214,249,221,0.32)\">—</span> Education</div><h2 class=\"reveal reveal-delay-1 font-bold leading-[1.08] tracking-[-0.02em]\" style=\"font-family:var(--font-display);font-size:clamp(2.2rem,4.5vw,3.4rem);color:#D6F9DD\">Academic background.</h2></div><div class=\"reveal reveal-delay-2 flex flex-col gap-[22px]\"><div class=\"relative grid gap-8 p-7 rounded-md transition-all duration-200 timeline-item-hover\" style=\"grid-template-columns:clamp(100px,160px,160px) 1fr;background:var(--glass);border:1px solid var(--glass-border);backdrop-filter:blur(20px)\"><div class=\"pt-1 text-[0.7rem] tracking-[0.04em]\" style=\"font-family:var(--font-mono);color:#99F7AB\">2022 — Present</div><div><h3 class=\"font-bold mb-1\" style=\"font-family:var(--font-display);font-size:1.2rem;color:#D6F9DD\">B.Sc. in Computer Science &amp; Engineering</h3><div class=\"text-[0.75rem] tracking-[0.04em] mb-[10px]\" style=\"font-family:var(--font-mono);color:#99F7AB\">Currently Pursuing · Dhaka, Bangladesh</div><p class=\"text-[0.9rem] leading-[1.75]\" style=\"color:rgba(214,249,221,0.62)\">Studying computer science fundamentals including data structures, algorithms, databases, software engineering, and computer networks. Supplementing coursework with hands-on web development projects to bridge theory and practice — building real-world applications that apply what I learn in the classroom.</p></div></div></div></div></section><section id=\"skills\" class=\"py-[clamp(80px,11vw,130px)]\"><div class=\"max-w-[1120px] mx-auto px-5 md:px-[60px]\"><div class=\"text-center mb-14\"><div class=\"reveal inline-flex items-center gap-[10px] mb-[18px] text-[0.68rem] tracking-[0.14em] uppercase\" style=\"font-family:v